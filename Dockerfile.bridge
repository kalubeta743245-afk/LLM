# Incunabula 24/7 bridge host (Koyeb free tier / any Docker host).
# Runs the full API (server.js serves UI + chat/models/v1); the OpenCode CLI
# runs inside for My Site Free chats. Cloudflare points BRIDGE_URL here.
# Secrets (SITE_PASSWORD etc.) are injected as env vars, never baked in.
FROM node:22-slim

RUN npm i -g opencode-ai@latest && opencode --version

WORKDIR /app
COPY incunabula/package.json incunabula/package-lock.json ./
RUN npm install --omit=dev
COPY incunabula/server.js ./server.js
COPY incunabula/netlify ./netlify
COPY incunabula/public ./public
COPY incunabula/worker ./worker

# Koyeb injects $PORT (default 8000) and routes HTTP to it.
ENV NODE_ENV=production
EXPOSE 8000
CMD ["sh", "-c", "PORT=${PORT:-8000} node server.js"]
