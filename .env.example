# ─────────────────────────────────────────────────────────────
# Galaxy LLM — environment template
# Copy this file to ".env" and fill in real values.
# ─────────────────────────────────────────────────────────────

# OpenRouter credentials (the upstream LLM provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model mapping (meteor -> Cohere North Mini Code)
UPSTREAM_MODEL=cohere/north-mini-code:free
SERVED_MODEL_NAME=meteor

# OpenRouter ranking/identification headers (optional but recommended)
APP_TITLE=Galaxy LLM
APP_REFERER=http://localhost:3000

# Server
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# Optional: protect this backend with a shared API key.
# If BACKEND_API_KEY is set, clients must send:
#   Authorization: Bearer <BACKEND_API_KEY>
# Leave blank to disable the gate (prototype mode).
# ─────────────────────────────────────────────────────────────
BACKEND_API_KEY=

# ─────────────────────────────────────────────────────────────
# Phase 2 placeholders (database + auth) — not used yet.
# ─────────────────────────────────────────────────────────────
# DATABASE_URL=
# JWT_SECRET=
