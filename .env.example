# ─────────────────────────────────────────────────────────────
# Galaxy LLM — environment template
# Copy this file to ".env" and fill in real values.
# ─────────────────────────────────────────────────────────────

# NVIDIA NIM credentials (the upstream LLM provider)
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Server
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# Optional: protect this backend with a shared API key.
# If BACKEND_API_KEY is set, clients must send:
#   Authorization: Bearer <BACKEND_API_KEY>
# Leave blank to disable the gate (prototype mode).
# ─────────────────────────────────────────────────────────────
BACKEND_API_KEY=

# ─────────────────────────────────────────────────────────────
# Appwrite (authentication, API keys, credits)
# ─────────────────────────────────────────────────────────────
# Required for authentication to work.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Optional Appwrite database/collection overrides
# APPWRITE_DATABASE_ID=galaxy-llm
# APPWRITE_API_KEYS_COLLECTION=api_keys
# INITIAL_CREDITS=40
