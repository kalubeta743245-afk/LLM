# ─────────────────────────────────────────────────────────────
# Galaxy LLM — environment template
# Copy this file to ".env" and fill in real values.
# ─────────────────────────────────────────────────────────────

# NVIDIA NIM credentials (upstream LLM provider)
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Token Harbor credentials (unified AI gateway)
TOKENHARBOR_API_KEY=your_tokenharbor_api_key_here
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1

# Token Forge credentials (AI gateway with verified routing)
TOKENFORGE_API_KEY=your_tokenforge_api_key_here
TOKENFORGE_BASE_URL=https://tokenforge.ai.studio

# OpenRouter credentials (model metadata enrichment)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OrcaRouter credentials (adaptive LLM routing, zero markup)
ORCAROUTER_API_KEY=your_orcarouter_api_key_here
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# Phoenix Grove credentials (OpenAI-compatible inference)
PHOENIXGROVE_API_KEY=your_phoenix_grove_api_key_here
PHOENIXGROVE_BASE_URL=https://api.pgsgrove.com/v1

# Server
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# Optional: protect this backend with a shared API key.
# If BACKEND_API_KEY is set, clients must send:
#   Authorization: Bearer <BACKEND_API_KEY>
# Leave blank to disable the gate (prototype mode).
# ─────────────────────────────────────────────────────────────
BACKEND_API_KEY=

# ─────────────────────────────────────────────────────────────
# Appwrite (authentication, API keys, credits)
# ─────────────────────────────────────────────────────────────
# Required for authentication to work.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Optional Appwrite database/collection overrides
# APPWRITE_DATABASE_ID=galaxy-llm
# APPWRITE_API_KEYS_COLLECTION=api_keys
# INITIAL_CREDITS=40
